/// @description coll_hook() -> { energy_lg, field, best, crunches, pairs_lg, balance } THE TIE-IN (q319), unwired by his rule. Ideas kept: energy's log10 as a resin lane (the dims bench's candidate multiplier, 1 + log10/10), the crunch count as a rebirth garnish, the clean factor as a tap multiplier while balanced, the stocks priced in profit for a shortcut
function coll_hook() {
	var _c = coll_init();
	return { energy_lg : _c.energy, field : _c.field, best : _c.best, crunches : _c.crunches, pairs_lg : _c.pairs_lg, balance : coll_clean(_c), stepk : coll_stepk(_c) };
}
